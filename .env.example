# Copy this file to .env.local and fill in what you need. Every variable is optional.

# Your production URL (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Password that unlocks editing on /goal and writing on /writings/new. Without it both are locked for everyone.
ADMIN_PASSWORD=

# Supabase - stores the visitor counter, your goals and posts written on the site. Run supabase/schema.sql once first.
# Without these, data is written to ./data/*.json, which is fine locally but is NOT
# persistent on serverless hosts such as Vercel or Netlify.
# SECURITY: the service-role key bypasses Row Level Security. Server-side only: never prefix it
# with NEXT_PUBLIC_ and never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional GitHub token (no scopes needed) for the footer's "last shipped" line.
# Only raises the API rate limit; it works without one.
GITHUB_TOKEN=

# Optional: sharper movie posters. Without it, movie posters come from Wikipedia (about 250px wide).
# Free key at https://www.themoviedb.org/settings/api (v3 key or v4 read-access token).
# This product uses the TMDB API but is not endorsed or certified by TMDB.
TMDB_API_KEY=
